<!-- Re-trigger Animate.css on scroll for .anim-on-scroll -->
<script>
    (function() {
        const ENTER_T = 0.8,
            EXIT_T = 0.0,
            COOLDOWN_MS = 600;
        const els = document.querySelectorAll(".anim-on-scroll");
        const state = new WeakMap();
        els.forEach(el => state.set(el, {
            armed: true,
            lastPlay: 0
        }));

        function play(el) {
            const now = performance.now();
            const s = state.get(el);
            if (!s.armed || (now - s.lastPlay) < COOLDOWN_MS) return;
            const anim = el.dataset.anim || "animate__fadeInDown";
            el.classList.remove("animate__animated", anim);
            void el.offsetWidth;
            el.style.setProperty("--animate-duration", "0.9s");
            el.classList.add("animate__animated", anim);
            s.armed = false;
            s.lastPlay = now;
            state.set(el, s);
            el.addEventListener("animationend", function onEnd() {
                el.classList.remove("animate__animated", anim);
                el.removeEventListener("animationend", onEnd);
            });
        }

        const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                const s = state.get(e.target);
                if (!s) return;
                if (e.intersectionRatio >= ENTER_T && s.armed) play(e.target);
                if (e.intersectionRatio <= EXIT_T && !s.armed) {
                    s.armed = true;
                    state.set(e.target, s);
                }
            });
        }, {
            threshold: [EXIT_T, 0.25, 0.5, 0.8, 1]
        });

        els.forEach(el => io.observe(el));
    })();
</script>