<!-- Hero / Slideshow -->
<!-- Hero / Slideshow (responsive height + better large-screen layout) -->
<!-- Hero / Slideshow -->
<div id="slideshow" data-controller="home" data-home-images-value='["<%= asset_path("image1.jpg") %>", "<%= asset_path("image2.jpg") %>"]' data-home-interval-value="2000" data-home-target="slideshow" class="relative w-full bg-cover bg-center md:bg-[position:center_30%] transition-all duration-1000 ease-in-out
         min-h-[clamp(520px,80vh,900px)]" style="background-image: url(<%= asset_path('image1.jpg') %>)">
    <!-- Overlay -->
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Content: Now vertically centered more -->
    <div class="relative  inset-0 flex items-center justify-center px-4 sm:px-6 py-10">
        <div class="flex mt-30 flex-col items-center w-full">

            <!-- Red Box -->
            <div class="w-full max-w-7xl mx-auto p-4 sm:p-6 md:p-10 bg-red-800/70 rounded-xl shadow-xl text-white text-center space-y-5 sm:space-y-7">
                <!-- Tabs -->
                <ul class="flex flex-wrap justify-center gap-2 sm:gap-3 text-sm sm:text-base md:text-lg font-semibold mb-4 sm:mb-6">
                    <li>
                        <button type="button" data-home-target="tab" data-action="click->home#activate" class="inline-block px-3 sm:px-5 py-2 rounded-t bg-white text-black">
                            <i class="fas fa-plane mr-2"></i> FLIGHTS
                        </button>
                    </li>
                    <li>
                        <button type="button" data-home-target="tab" data-action="click->home#activate" class="inline-block px-3 sm:px-5 py-2 rounded-t bg-transparent text-white hover:bg-white/10">
                            <i class="fas fa-bed mr-2"></i> HOTELS
                        </button>
                    </li>
                    <li>
                        <button type="button" data-home-target="tab" data-action="click->home#activate" class="inline-block px-3 sm:px-5 py-2 rounded-t bg-transparent text-white hover:bg-white/10">
                            <i class="fas fa-suitcase mr-2"></i> HOLIDAYS
                        </button>
                    </li>
                    <li>
                        <button type="button" data-home-target="tab" data-action="click->home#activate" class="inline-block px-3 sm:px-5 py-2 rounded-t bg-transparent text-white hover:bg-white/10">
                            <i class="fas fa-car mr-2"></i> CAR
                        </button>
                    </li>
                    <li>
                        <button type="button" data-home-target="tab" data-action="click->home#activate" class="inline-block px-3 sm:px-5 py-2 rounded-t bg-transparent text-white hover:bg-white/10">
                            <i class="fas fa-ship mr-2"></i> CRUISE
                        </button>
                    </li>
                </ul>

                <!-- Search Form -->
                <%= form_with url: "#", method: :get, local: true do %>
                <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 justify-center items-stretch w-full">
                    <%= text_field_tag :from, nil, placeholder: "Flying From",
              class: "flex-1 min-w-[140px] px-4 py-3 rounded text-white bg-transparent border border-white placeholder-white" %>
                    <%= text_field_tag :to, nil, placeholder: "Flying To",
              class: "flex-1 min-w-[140px] px-4 py-3 rounded text-white bg-transparent border border-white placeholder-white" %>
                    <%= date_field_tag :departure, nil,
              class: "flex-1 min-w-[140px] px-4 py-3 rounded text-white bg-transparent border border-white placeholder-white" %>
                    <%= date_field_tag :return, nil,
              class: "flex-1 min-w-[140px] px-4 py-3 rounded text-white bg-transparent border border-white placeholder-white" %>
                    <%= submit_tag "Search Flights",
              class: "w-full sm:w-auto px-6 py-3 text-white bg-gradient-to-r from-red-400 via-red-700 to-red-800 hover:bg-gradient-to-br font-bold rounded-lg" %>
                </div>
                <% end %>
            </div>

            <!-- Top Deals -->
            <div class="mt-8 w-full">
                <h3 class="text-lg sm:text-2xl font-bold text-white mb-4 text-center">Top Deals</h3>
                <div data-home-target="destinationList" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 px-2">
                    <!-- Cards injected by JS -->
                </div>
            </div>

        </div>
    </div>
</div>


<!-- Welcome -->
<section data-controller="scroll-animate" class="relative w-full py-10 sm:py-14 px-4 sm:px-6 overflow-hidden text-center bg-gradient-to-r from-yellow-400/90 via-yellow-500/90 to-yellow-600/90 text-black">
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-tr from-yellow-600/30 via-yellow-500/30 to-yellow-400/30"></div>
    <div class="relative z-10 max-w-4xl mx-auto">
        <h2 data-scroll-animate-target="card" class="opacity-0 text-2xl sm:text-4xl font-extrabold mb-4 uppercase tracking-wide">
            Welcome to RR Travels
        </h2>
        <p data-scroll-animate-target="card" class="opacity-0 text-base sm:text-lg leading-relaxed">
            Thank you for your stay at our web portal which serves as a one-stop solution for all your itinerary needs.
            The team of <strong>RR Travels</strong> cordially welcomes you and thanks you for sparing your precious moments visiting our site.
            Our team comprises of travel connoisseurs who specialize in providing itinerary solutions at very competitive rates.
        </p>
    </div>
</section>

<!-- Top Destinations (sliding bg) -->
<div data-controller="grid" data-grid-images-value='["<%= asset_path("image1.jpg") %>", "<%= asset_path("image2.jpg") %>"]' data-grid-interval-value="3000" data-grid-target="background" class="relative bg-cover bg-center w-full min-h-[70vh] sm:min-h-[80vh] flex items-center justify-center" style="background-image: url(<%= asset_path("image1.jpg") %>); background-size: cover; background-position: center;">
    <div class="absolute inset-0 bg-red-800/70"></div>
    <div data-controller="hover hover-mobile scroll-animate" class="relative z-10 w-full max-w-6xl text-white px-4 py-10">
        <div class="text-center mb-6 sm:mb-8">
            <h2 class="text-2xl sm:text-3xl font-extrabold uppercase mb-2">OUR TOP DESTINATION</h2>
            <p class="text-base sm:text-lg leading-relaxed">
                At Reliance Travels, we aim to facilitate our customers with incomparable rates and flexible payment plans.
                Contact us any time to learn more about fares to your preferred top destination.
            </p>
        </div>

        <!-- Destination Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% animation_classes = [
        "animate__slideInLeft", "animate__slideInDown", "animate__slideInRight",
        "animate__slideInUp", "animate__slideInDown", "animate__slideInLeft"
      ] %>

            <% destinations = [
        { name: "Gambia", image: "BJL.jpg", description: "Explore the heart of West Africa." },
        { name: "Nigeria", image: "LOS.jpg", description: "Visit vibrant Lagos and more." },
        { name: "South Africa", image: "JNB.jpg", description: "Safari adventures and city life." },
        { name: "Kenya", image: "NBO.jpg", description: "The land of nature and wildlife." },
        { name: "Singapore", image: "SIN.jpg", description: "A modern marvel of Asia." },
        { name: "Ghana", image: "ACC.jpg", description: "Rich history and golden beaches." }
      ] %>

            <% destinations.each_with_index do |d, i| %>
            <div class="relative rounded-lg shadow-lg overflow-hidden opacity-0" data-scroll-animate-target="card" data-animate="<%= animation_classes[i] %>" data-index="<%= i %>" data-action="mouseenter->hover#show mouseleave->hover#hide click->hover-mobile#toggle">
                <!-- Scaled heights per device (no fixed px) -->
                <%= image_tag d[:image], class: "w-full h-48 sm:h-56 md:h-64 object-cover transition duration-300 ease-in-out group-hover:blur-sm" %>

                <!-- Overlay -->
                <div class="absolute inset-0 hidden flex-col items-center justify-center text-center text-white bg-black/40 px-4 space-y-3" data-hover-target="overlay" data-overlay-index="<%= i %>">
                    <div>
                        <div class="text-lg font-bold"><%= d[:name] %></div>
                        <div class="text-sm"><%= d[:description] %></div>
                    </div>
                    <button class="px-4 sm:px-5 mt-6 py-1.5 sm:py-2 bg-yellow-400 text-black font-semibold rounded-full shadow-md animate__animated animate__bounce animate__infinite">
                        Book Now
                    </button>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>

<!-- Divider -->
<div class="w-full h-[4px] border-t-2 border-yellow-400 bg-red-800"></div>

<!-- Deals section (cards that re-animate on scroll) -->
<div class="w-full bg-white flex flex-col items-center justify-center px-4 py-12">
    <div class="max-w-7xl w-full text-center space-y-6">
        <h2 class="text-2xl sm:text-4xl font-bold text-gray-800 uppercase">
            Explore Our Best Flight Deals
        </h2>
        <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto">
            Find affordable fares with amazing comfort and flexible booking options. Our popular destinations are just a click away.
        </p>

        <!-- Use a grid that collapses cleanly on any phone -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
            <!-- Card template -->
            <% deals = [
        { title: "Port Louis Flight Deal", img: "BJL.jpg", price: "£1220" },
        { title: "Johannesburg Flight Deal", img: "NBO.jpg", price: "£789" },
        { title: "Nairobi Flight Deal", img: "NBO.jpg", price: "£699" },
        { title: "Accra Flight Deal", img: "ACC.jpg", price: "£1234" },
      ] %>

            <% deals.each_with_index do |d, idx| %>
            <div class="bg-white rounded-md shadow-md overflow-hidden border border-gray-200 anim-on-scroll" style="--animate-delay: <%= (idx * 150) %>ms;" data-anim="animate__fadeInDown">
