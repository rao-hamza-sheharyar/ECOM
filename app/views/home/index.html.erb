                    <h3 class="font-bold text-sm mb-1"><%= d[:title] %></h3>
                    <p class="text-yellow-500 text-sm">✈ From Heathrow</p>
                    <p class="text-sm text-gray-500 mt-2">Starting From</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1"><%= d[:price] %><span class="text-sm">/Person</span></p>
                    <p class="text-xs text-gray-500 mt-1">Return, Incl. Taxes</p>
                </div>
                <div class="px-4 pb-4">
                    <button class="w-full sm:w-auto px-4 mt-3 py-1.5 text-sm bg-yellow-400 text-black font-semibold rounded-full shadow-md">
                        Book Now
                    </button>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>

<!-- Divider -->
<div class="w-full h-[4px] border-t-2 border-yellow-400 bg-red-800"></div>

