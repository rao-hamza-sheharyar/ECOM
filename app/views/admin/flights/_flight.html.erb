<div id="<%= dom_id flight %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Airline:</strong>
    <%= flight.airline %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Origin:</strong>
    <%= flight.origin %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Destination:</strong>
    <%= flight.destination %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Departure date:</strong>
    <%= flight.departure_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Arrival date:</strong>
    <%= flight.arrival_date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= flight.price %>
  </div>
</div>
