<footer class="w-full bg-white text-black">
    <!-- Top -->
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 px-4 py-10">
        <!-- Col 1 -->
        <div>
            <h3 class="font-bold text-lg mb-3">RRTravels Ltd.</h3>
            <p class="text-sm leading-relaxed mb-4">
                Providing a wide variety of travel products at unbeatable prices, with matchless services to all parts of the world.
                We make the reservation process simple, fast, and hassle-free. Achieving customer satisfaction is our ultimate goal.
            </p>
            <button class="border border-yellow-400 px-4 py-2 text-sm font-semibold hover:bg-yellow-400 hover:text-black transition">
                READ MORE
            </button>
        </div>

        <!-- Col 2 -->
        <div>
            <h3 class="font-bold text-lg mb-3">Newsletter</h3>
            <p class="text-sm mb-3">Get the latest flight deals directly in your inbox.</p>

            <%= form_with url: root_path, method: :post, local: true, class: "space-y-2" do |f| %>
            <%= f.email_field :email, placeholder: "Enter Your Email",
      class: "w-full rounded-full px-4 py-2 border border-gray-300 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>

            <p class="text-xs">* We respect your privacy and do not send spam.</p>

            <%= f.button type: "submit", class: "px-6 py-3 text-white bg-gradient-to-r from-red-400 via-red-700 to-red-800 hover:bg-gradient-to-br font-bold rounded-lg text-base sm:text-lg flex items-center justify-center" do %>
            <i class="fas fa-paper-plane mr-1"></i> SUBSCRIBE
            <% end %>
            <% end %>
        </div>

        <!-- Col 3 -->
        <div>
            <h3 class="font-bold text-lg mb-3">Contact Us</h3>
            <ul class="space-y-3 text-sm">
                <li class="flex items-center gap-3">
                    <i class="fas fa-phone text-yellow-400"></i>
                    <span>0207 993 6068</span>
                </li>
                <li class="flex items-center gap-3">
                    <i class="fab fa-whatsapp text-yellow-400"></i>
                    <span>0207 993 5374</span>
                </li>
                <li class="flex items-center gap-3">
                    <i class="fas fa-envelope text-yellow-400"></i>
                    <span>info@rrtravels.co.uk</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Yellow bar: logos left, socials right (responsive) -->
    <div class="bg-yellow-400 py-2">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-3">
            <!-- Payment logos (wrap & scroll on small so it never overflows) -->
            <div class="w-full md:w-auto overflow-x-auto">
                <div class="flex items-center gap-3 min-w-max">
                    <%= image_tag "footor/visa.png",          class: "h-6 w-auto", alt: "Visa" %>
                    <%= image_tag "footor/master.png",        class: "h-6 w-auto", alt: "MasterCard" %>
                    <%= image_tag "footor/delta.png",         class: "h-6 w-auto", alt: "Delta" %>
                    <%= image_tag "footor/mastro.png",        class: "h-6 w-auto", alt: "Maestro" %>
                    <%= image_tag "footor/visaelectron.png",  class: "h-6 w-auto", alt: "Visa Electron" %>
                    <%= image_tag "footor/baclays-power.png", class: "h-6 w-auto", alt: "Powered by Barclaycard" %>
                </div>
            </div>

            <!-- Socials (brand colors, link_to) -->
            <div class="flex items-center justify-center md:justify-end gap-2">
                <%= link_to "#", class: "w-9 h-9 rounded-full grid place-items-center text-white",
                      title: "Facebook", aria: { label: "Facebook" },
                      style: "background-color:#1877F2" do %>
                <i class="fab fa-facebook-f text-sm"></i>
                <% end %>

                <%= link_to "#", class: "w-9 h-9 rounded-full grid place-items-center text-white",
                      title: "Twitter", aria: { label: "Twitter" },
                      style: "background-color:#1DA1F2" do %>
                <i class="fab fa-twitter text-sm"></i>
                <% end %>

                <%= link_to "#", class: "w-9 h-9 rounded-full grid place-items-center text-white",
                      title: "YouTube", aria: { label: "YouTube" },
                      style: "background-color:#FF0000" do %>
                <i class="fab fa-youtube text-sm"></i>
                <% end %>

                <%= link_to "#", class: "w-9 h-9 rounded-full grid place-items-center text-white",
                      title: "Google", aria: { label: "Google" },
                      style: "background-color:#DB4437" do %>
                <i class="fab fa-google text-sm"></i>
                <% end %>

                <%= link_to "#", class: "w-9 h-9 rounded-full grid place-items-center text-white",
                      title: "Instagram", aria: { label: "Instagram" },
                      style: "background-color:#E4405F" do %>
                <i class="fab fa-instagram text-sm"></i>
                <% end %>
            </div>
        </div>
    </div>
</footer>